# =========================================================================
# Unity .gitignore
# Tracks only Assets/, Packages/, ProjectSettings/, and root documentation
# =========================================================================

# Unity generated folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Visual Studio / Rider / IDE generated files and folders
.vs/
.idea/
.vscode/
/*.csproj
/*.unityproj
/*.sln
/*.slnx
/*.suo
/*.tmp
/*.user
/*.userprefs
/*.pidb
/*.booproj
/*.svd
/*.pdb
/*.mdb
/*.opendb
/*.VC.db

# Unity profiler and crash artifacts
sysinfo.txt
*.stackdump

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
[Tt]humbs.db

# Builds
*.apk
*.aab
*.unitypackage
*.app
